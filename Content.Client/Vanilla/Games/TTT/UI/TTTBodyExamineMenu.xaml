<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    MaxHeight="600"
    MinWidth="330">
    <BoxContainer Margin="0 0 0 5"
                  Orientation="Vertical">
        <SpriteView OverrideDirection="South"
                    Scale="2 2"
                    Name="SpriteView"
                    Access="Public"
                    SetSize="64 64"/>
        <RichTextLabel Name="NameLabel"
                       Access="Public"
                       SetWidth="300"/>
        <RichTextLabel Name="RoleLabel"
                       Access="Public"
                       SetWidth="300"/>
        <RichTextLabel Name="GunLabel"
                       Access="Public"
                       SetWidth="300"/>
        <RichTextLabel Name="DeathTimeLabel"
                       Access="Public"
                       SetWidth="300"/>
    </BoxContainer>
</controls:FancyWindow>
