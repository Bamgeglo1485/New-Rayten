<Control xmlns="https://spacestation14.io"
         xmlns:tabs="clr-namespace:Content.Client.Vanilla.Options.UI.Tabs"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8">

                <ui:OptionSlider Name="GrainStrengthSlider"
                                 Title="Сила эффекта зернистости"
                                 ToolTip="Чем выше значение, тем выше шум в тёмных участках."/>
                <ui:OptionSlider Name="SinCityStrengthSlider"
                                 Title="Насыщенность"
                                 ToolTip="Чем выше значение, тем тусклее картинка."/>

            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</Control>
