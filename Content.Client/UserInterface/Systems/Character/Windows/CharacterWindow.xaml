<windows:CharacterWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:windows="clr-namespace:Content.Client.UserInterface.Systems.Character.Windows"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Systems.Character.Controls"
    Title="{Loc 'character-info-title'}"
    MinWidth="400"
    MinHeight="545">
    <ScrollContainer>
        <BoxContainer Orientation="Vertical">
            <BoxContainer Orientation="Horizontal">
                <SpriteView OverrideDirection="South" Scale="2 2" Name="SpriteView" Access="Public" SetSize="64 64"/>
                <BoxContainer Orientation="Vertical" VerticalAlignment="Top">
                    <Label Name="NameLabel" Access="Public"/>
                    <Label Name="SubText" VerticalAlignment="Top" StyleClasses="LabelSubText" Access="Public"/>
                </BoxContainer>
            </BoxContainer>
            <Label Text="Навыки:" Margin="0, 5, 0, 5" Access="Public" />
            <BoxContainer Orientation="Vertical" VerticalAlignment="Top" HorizontalExpand="true">
                <!-- Пилотирование -->
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Text="Пилотирование:" StyleClasses="LabelSubText" MinSize="115 0" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
                        <ProgressBar Name="Piloting1" MinValue="0" MaxValue="300" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Piloting2" MinValue="0" MaxValue="600" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Piloting3" MinValue="0" MaxValue="900" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                    </BoxContainer>
                </BoxContainer>

                <!-- Стрельба -->
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Text="Стрельба:" StyleClasses="LabelSubText" MinSize="115 0" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
                        <ProgressBar Name="RangeWeapon1" MinValue="0" MaxValue="300" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="RangeWeapon2" MinValue="0" MaxValue="600" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="RangeWeapon3" MinValue="0" MaxValue="900" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                    </BoxContainer>
                </BoxContainer>

                <!-- Ближний бой -->
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Text="Ближний бой:" StyleClasses="LabelSubText" MinSize="115 0" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
                        <ProgressBar Name="MeleeWeapon1" MinValue="0" MaxValue="300" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="MeleeWeapon2" MinValue="0" MaxValue="600" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="MeleeWeapon3" MinValue="0" MaxValue="900" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                    </BoxContainer>
                </BoxContainer>
                
                <!-- Медицина -->
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Text="Медицина:" StyleClasses="LabelSubText" MinSize="115 0" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
                        <ProgressBar Name="Medicine1" MinValue="0" MaxValue="300" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Medicine2" MinValue="0" MaxValue="600" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Medicine3" MinValue="0" MaxValue="900" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                    </BoxContainer>
                </BoxContainer>
                
                <!-- Химия -->
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Text="Химия:" StyleClasses="LabelSubText" MinSize="115 0" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
                        <ProgressBar Name="Chemistry1" MinValue="0" MaxValue="300" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Chemistry2" MinValue="0" MaxValue="600" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Chemistry3" MinValue="0" MaxValue="900" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                    </BoxContainer>
                </BoxContainer>

                <!-- Инженерия -->
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Text="Инженерия:" StyleClasses="LabelSubText" MinSize="115 0" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
                        <ProgressBar Name="Engineering1" MinValue="0" MaxValue="300" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Engineering2" MinValue="0" MaxValue="600" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Engineering3" MinValue="0" MaxValue="900" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                    </BoxContainer>
                </BoxContainer>

                <!-- Строительство -->
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Text="Строительство:" StyleClasses="LabelSubText" MinSize="115 0" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
                        <ProgressBar Name="Buildig1" MinValue="0" MaxValue="300" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Buildig2" MinValue="0" MaxValue="600" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Buildig3" MinValue="0" MaxValue="900" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                    </BoxContainer>
                </BoxContainer>

                <!-- Исследования -->
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Text="Исследования:" StyleClasses="LabelSubText" MinSize="115 0" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
                        <ProgressBar Name="Research1" MinValue="0" MaxValue="300" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Research2" MinValue="0" MaxValue="600" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Research3" MinValue="0" MaxValue="900" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                    </BoxContainer>
                </BoxContainer>

                <!-- Роботехника -->
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Text="Роботехника:" StyleClasses="LabelSubText" MinSize="115 0" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="true">
                        <ProgressBar Name="Robotics1" MinValue="0" MaxValue="300" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Robotics2" MinValue="0" MaxValue="600" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                        <ProgressBar Name="Robotics3" MinValue="0" MaxValue="900" HorizontalExpand="false" Modulate="green" SetSize="75 10" Margin="5,0,0,0" Access="Public"/>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
            <Label Name="ObjectivesLabel" Access="Public" Text="{Loc 'character-info-objectives-label'}" HorizontalAlignment="Center"/>
            <BoxContainer Orientation="Vertical" Name="Objectives" Access="Public"/>
            <cc:Placeholder Name="RolePlaceholder" Access="Public" PlaceholderText="{Loc 'character-info-roles-antagonist-text'}"/>
        </BoxContainer>
    </ScrollContainer>
</windows:CharacterWindow>
