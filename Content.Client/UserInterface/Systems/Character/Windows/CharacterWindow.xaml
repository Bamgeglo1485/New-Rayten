<windows:CharacterWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:windows="clr-namespace:Content.Client.UserInterface.Systems.Character.Windows"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Systems.Character.Controls"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    Title="{Loc 'character-info-title'}"
    SetWidth="685"
    MinHeight="850"
    Resizable="False">
    <ScrollContainer Name="MainScroll"
                     Access="Public">
        <BoxContainer Orientation="Vertical">
            <BoxContainer Orientation="Horizontal">
                <SpriteView OverrideDirection="South"
                            Scale="2 2"
                            Name="SpriteView"
                            Access="Public"
                            SetSize="64 64"/>
                <BoxContainer Orientation="Vertical"
                              VerticalAlignment="Top">
                    <Label Name="NameLabel"
                           Access="Public"/>
                    <Label Name="SubText"
                           VerticalAlignment="Top"
                           StyleClasses="LabelSubText"
                           Access="Public"/>
                    <Label Name="RoleType"
                           VerticalAlignment="Top"
                           StyleClasses="LabelSubText"
                           Access="Public"/>
                </BoxContainer>
            </BoxContainer>

            <Label Name="TabName"
                   Text="Навыки"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   StyleClasses="LabelHeading"
                   Access="Public"/>
            <cc:HLine Color="#05014a"
                      Thickness="4"/>
            <cc:HSpacer Spacing="10"/>
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True">
                <Button Name="TabInfo"
                        Text="Информация"
                        Disabled="False"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        StyleClasses="ButtonSquare"
                        Margin="0"
                        Access="Public"/>
                <Button Name="TabBackground"
                        Text="Предыстория"
                        Disabled="False"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        StyleClasses="ButtonSquare"
                        Margin="0"
                        Access="Public"/>
            </BoxContainer>
            <cc:HLine Color="#05014a"
                      Thickness="2"/>
            <cc:HSpacer Spacing="10"/>


            <BoxContainer Orientation="Vertical"
                          Name="InfoContainer"
                          Visible="false"
                          Access="Public">
                <Label Name="ObjectivesLabel"
                       Access="Public"
                       Text="{Loc 'character-info-objectives-label'}"
                       HorizontalAlignment="Center"/>
                <BoxContainer Orientation="Vertical"
                              Name="Objectives"
                              Access="Public"/>
                <cc:Placeholder Name="RolePlaceholder"
                                Access="Public"
                                PlaceholderText="{Loc 'character-info-roles-antagonist-text'}"/>
            </BoxContainer>

            <BoxContainer Orientation="Vertical"
                          Name="BackgroundContainer"
                          Visible="false"
                          Access="Public"
                          SetWidth="660">

            </BoxContainer>

        </BoxContainer>
    </ScrollContainer>
</windows:CharacterWindow>
