<Control xmlns="https://spacestation14.io"
         xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
         VerticalExpand="True"
         HorizontalExpand="True"
         HorizontalAlignment="Stretch"
         MinWidth="120" >
<BoxContainer Name="MainContainer" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Stretch">
        <PanelContainer Name="Background"
                        Access="Public"
                        StyleClasses="SkillTopRoundedBackground"
                        MinHeight="15"
                        VerticalExpand="False"
                        HorizontalExpand="True"
                        Margin="0 0 0 -5"/>
        <Button Name="MainButton"
                HorizontalExpand="True"
                VerticalExpand="True"
                StyleClasses="SkillBottomRoundedButton"
                Margin="0">
            <BoxContainer Orientation="Vertical"
                          VerticalExpand="True"
                          Margin="0">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Top" Margin="0">
                        <Control MinHeight="7"></Control>
                        <RichTextLabel Name="SkillNameLabel" HorizontalAlignment="Center" HorizontalExpand="True" Margin="0"/>
                        <Control MinHeight="7"></Control>
                        <TextureRect Name="SkillTexture" TextureScale="1 1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <customControls:HSeparator StyleClasses="LowDivider" Margin="0 5 0 5"/>
                        <RichTextLabel Name="LvlLabel" HorizontalAlignment="Center" StyleClasses="LabelSubText" HorizontalExpand="True"/>
                        <RichTextLabel Name="ExpLabel" HorizontalAlignment="Center" StyleClasses="LabelSubText" HorizontalExpand="True"/>
                    </BoxContainer>
            </BoxContainer>
        </Button>
    </BoxContainer>
</Control>